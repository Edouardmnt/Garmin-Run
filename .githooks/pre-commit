#!/bin/sh
# Avant chaque commit : qualité du code et tests rapides (environ 20 à 40 s).
# Les tests lents (interface complète, synchronisation, modèles) tournent dans la CI, qui seule publie l'image.
# Activer une fois : git config core.hooksPath .githooks        Contourner exceptionnellement : git commit --no-verify
set -e
python -m ruff check .
python -m pytest -q -m "not slow" -n auto -x -p no:cacheprovider
